APP_NAME=Wedpluz
APP_ENV=local                      # local | staging | production
APP_KEY=                           # php artisan key:generate
APP_DEBUG=true                     # MUST be false in staging/production
APP_URL=http://localhost:8000      # public API origin, e.g. https://api.wedpluz.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single                   # production: daily or stderr (container)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                    # production: info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wedpluz
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array               # stateless API (bearer tokens)
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=
SESSION_DOMAIN=

BROADCAST_CONNECTION=null          # reverb to enable realtime; null disables it
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis             # workers: critical,notifications,broadcasts,default,low

CACHE_STORE=redis

MEMCACHED_HOST=

REDIS_CLIENT=predis                # phpredis if the extension is installed
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###################################
MAIL_MAILER=zeptomail              # log for local development
MAIL_MAILER=zeptomail              # log for local development

################ LOG ###################

################ MAILTRAP ###################

################ ZOHO ###################
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

################ mailersend ###################

################ sendgrid ###################

################ resend ###################

# Set a default 'from' address
MAIL_FROM_ADDRESS="no-reply@wedpluz.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADMIN=

MEDIA_DRIVER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=
CLOUDINARY_SECURE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROADCAST_DRIVER=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

