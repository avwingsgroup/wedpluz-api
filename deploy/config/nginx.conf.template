# Wedpluz API — dedicated nginx virtual host (rendered by provision.sh to /etc/nginx/sites-available/wedpluz-api).
# Only server_name {{DOMAIN}} is handled here; other sites and the default server are untouched.
# Certbot adds the TLS server block and the HTTP -> HTTPS redirect to this file.

# Rate limiting at the edge, before PHP: 20 req/s per IP with bursts (the app adds per-route limits).
limit_req_zone $binary_remote_addr zone=wedpluz_api:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    root {{APP_DIR}}/current/public;
    index index.php;
    charset utf-8;

    # Largest upload purpose is 50 MB (vendor works, message attachments).
    client_max_body_size 60m;

    access_log /var/log/nginx/wedpluz-api.access.log;
    error_log  /var/log/nginx/wedpluz-api.error.log warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Enable once HTTPS is confirmed working (certbot):
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json application/xml text/plain text/css application/javascript image/svg+xml;

    # Never serve dotfiles (.env, .git) or files outside public/.
    location ~ /\.(?!well-known) { deny all; }

    location / {
        limit_req zone=wedpluz_api burst=40 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Long-lived caching for generated static assets (local fallback images).
    location ~* \.(?:jpg|jpeg|png|webp|svg|ico|css|js|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    location ~ \.php$ {
        fastcgi_pass unix:{{FPM_SOCKET}};
        fastcgi_index index.php;
        include fastcgi_params;
        # $realpath_root resolves the `current` symlink, so a deploy switches code atomically.
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 120s;
        fastcgi_hide_header X-Powered-By;
    }

    # {{REVERB_BLOCK_START}}
    # Realtime (Laravel Reverb, Pusher protocol): wss://{{DOMAIN}}/app/<key>
    location ~ ^/(app|apps)/ {
        proxy_pass http://127.0.0.1:{{REVERB_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    # {{REVERB_BLOCK_END}}
}
