# =============================================================================
# Wedpluz API — production environment
# Installed by provision.sh as <app-dir>/shared/.env (mode 640). Generated
# values are filled in; provider keys are left for you to complete.
# Never commit the filled-in file. Every variable: docs/environment-variables.md
# After editing on the server:  cd <app-dir>/current && php artisan config:cache && php artisan queue:restart
# =============================================================================

APP_NAME=Wedpluz
APP_ENV=production
APP_DEBUG=false
APP_KEY={{APP_KEY}}
APP_URL={{APP_URL}}
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache

WEDPLUZ_WEB_ORIGIN=https://wedpluz.com
WEDPLUZ_ADMIN_ORIGIN=https://admin.wedpluz.com
CORS_ALLOWED_ORIGINS=https://wedpluz.com,https://www.wedpluz.com,https://admin.wedpluz.com
WEDPLUZ_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ---- Database / Redis (local services created by provision.sh) -------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE={{DB_DATABASE}}
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD={{DB_PASSWORD}}
DB_SSLMODE=prefer

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD={{REDIS_PASSWORD}}
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# ---- Files ------------------------------------------------------------------
FILESYSTEM_DISK=local
# local keeps private files in shared/storage (backed up with the server);
# s3 is recommended once you have a bucket.
PRIVATE_DISK_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
PRIVATE_BUCKET=

# ---- Operations ---------------------------------------------------------------
HEALTH_CHECK_TOKEN={{HEALTH_TOKEN}}
# Off-server copy of the nightly database backup (needs the aws CLI), e.g. s3://wedpluz-backups/db
BACKUP_S3_URI=

# ---- Email (ZeptoMail API) ------------------------------------------------------
MAIL_MAILER=zeptomail
MAIL_FROM_ADDRESS="no-reply@wedpluz.com"
MAIL_FROM_NAME="Wedpluz"
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_WEBHOOK_KEY=

# ---- Media (Cloudinary) -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wedpluz

# ---- Google sign-in ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wedpluz.com/auth/google/callback
# Extra allowed callbacks. On the STAGING server: https://staging.wedpluz.com/auth/google/callback
# (each must also be an Authorized redirect URI in Google Cloud Console). Leave empty in production.
GOOGLE_REDIRECT_URIS=
GOOGLE_CLIENT_IDS=

# ---- Payments --------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://api.monnify.com
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.paypal.com

# ---- SMS / WhatsApp / Push / Identity ----------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=Wedpluz
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
FCM_PROJECT_ID=
FCM_CREDENTIALS=
PREMBLY_APP_ID=
PREMBLY_API_KEY=
PREMBLY_WEBHOOK_SECRET=

# ---- Realtime (Laravel Reverb behind nginx at /app) --------------------------------------------
BROADCAST_CONNECTION={{BROADCAST_CONNECTION}}
REVERB_APP_ID={{REVERB_APP_ID}}
REVERB_APP_KEY={{REVERB_APP_KEY}}
REVERB_APP_SECRET={{REVERB_APP_SECRET}}
REVERB_HOST={{DOMAIN}}
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT={{REVERB_PORT}}
REVERB_ALLOWED_ORIGINS=wedpluz.com,www.wedpluz.com,admin.wedpluz.com

# ---- AI (optional) ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
